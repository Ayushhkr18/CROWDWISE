  "tips": {
    "regular": [
      {
        "en": "Plan your visits during off-peak hours (early morning or late evening) to avoid heavy crowds.",
        "hi": "भारी भीड़ से बचने के लिए ऑफ-पीक घंटों (सुबह जल्दी या देर शाम) में जाने की योजना बनाएं।"
      },
      {
        "en": "Keep a digital copy of your festival pass and ID handy for quick entry checks.",
        "hi": "त्वरित प्रवेश जांच के लिए अपने फेस्टिवल पास और आईडी की डिजिटल कॉपी अपने पास रखें।"
      }
    ],
    "elderly": [
      {
        "en": "Utilize step-free priority ramps and shaded rest stops along the grand avenue.",
        "hi": "भव्य मार्ग के साथ चरण-मुक्त प्राथमिकता रैंप और छायादार विश्राम स्थलों का उपयोग करें।"
      },
      {
        "en": "Request wheelchair assistance at the Central Information & Wheelchair Desk if needed.",
        "hi": "यदि आवश्यक हो तो केंद्रीय सूचना और व्हीलचेयर डेस्क पर व्हीलचेयर सहायता का अनुरोध करें।"
      }
    ],
    "family": [
      {
        "en": "Designate a clear meeting point like the Banyan Tree in case family members get separated.",
        "hi": "परिवार के सदस्यों के अलग होने की स्थिति में बरगद के पेड़ जैसा एक स्पष्ट मिलन बिंदु तय करें।"
      },
      {
        "en": "Keep kids hydrated and use quiet zones for a quick break from the excitement.",
        "hi": "बच्चों को हाइड्रेटेड रखें और उत्साह से थोड़ी राहत पाने के लिए शांत क्षेत्रों का उपयोग करें।"
      }
    ],
    "wheelchair": [
      {
        "en": "Stick to the Wheelchair-Friendly Priority Route which ensures step-free paths and ramps.",
        "hi": "व्हीलचेयर-अनुकूल प्राथमिकता मार्ग पर टिके रहें जो चरण-मुक्त पथ और रैंप सुनिश्चित करता है।"
      },
      {
        "en": "Priority accessible restrooms are available near the Quiet Garden & Rest Park zone.",
        "hi": "शांत गार्डन और विश्राम पार्क ज़ोन के पास प्राथमिकता सुलभ शौचालय उपलब्ध हैं।"
